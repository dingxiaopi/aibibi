{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "paths": { "@/*": ["./web/*"] },
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "jsx": "react-jsx",
    "types": ["./worker-configuration.d.ts", "node", "vite/client"]
  },
  "include": ["src/**/*.ts", "tests/**/*.ts", "web/**/*.ts", "web/**/*.tsx", "vite.config.ts", "worker-configuration.d.ts"]
}
