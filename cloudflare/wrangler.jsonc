{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "aibibi",
  "workers_dev": true,
  "preview_urls": true,
  "main": "src/index.ts",
  "version_metadata": { "binding": "CF_VERSION_METADATA" },
  "compatibility_date": "2026-10-13",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": [
      "/api/*",
      "/data/*",
      "/",
      "/c/*",
      "/sku/*",
      "/shops",
      "/shops/*",
      "/shop/*",
      "/official",
      "/official/*",
      "/favorites",
      "/sitemap.xml",
      "/robots.txt",
    ],
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "aibibi",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "./migrations",
    },
  ],
  "vars": {
    "PUBLIC_SITE": "true",
    // Seconds public pages and reads stay in the edge cache (custom domain only; see src/cache.ts).
    "EDGE_CACHE_SECONDS": "300",
  },
  "secrets": { "required": ["ADMIN_PASSWORD", "COLLECTOR_INGEST_TOKEN"] },
  // Collection is local-only; an empty list removes the old cloud collector's cron.
  "triggers": { "crons": [] },
  "observability": { "enabled": true, "head_sampling_rate": 1 },
}
