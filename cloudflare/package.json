{
  "name": "aibibi",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "npm run web:build && node scripts/wrangler.mjs dev --local",
    "types": "node scripts/wrangler.mjs types",
    "check": "tsc --noEmit",
    "cost:benchmark": "node scripts/cost-benchmark.mjs",
    "test": "tsx --test tests/*.test.ts",
    "db:migrate": "node scripts/wrangler.mjs d1 migrations apply DB --local",
    "db:seed": "node scripts/seed-local.mjs",
    "build": "npm run web:build && node scripts/wrangler.mjs deploy --dry-run",
    "web:build": "vite build --config vite.config.ts",
    "update": "cd .. && python3 -m collector.update",
    "collect:local": "cd .. && python3 -m collector.collect && cd cloudflare && node scripts/export-local.mjs",
    "export:local": "node scripts/export-local.mjs",
    "sync:local": "node --import ./scripts/proxy.mjs scripts/sync-local.mjs",
    "push:local": "node --import ./scripts/proxy.mjs scripts/push-local.mjs",
    "web:dev": "vite --config vite.config.ts --host 127.0.0.1 --port 5173 --strictPort",
    "deploy": "npm run web:build && node scripts/wrangler.mjs deploy",
    "prepare": "node scripts/prepare-instance.mjs",
    "precheck": "node scripts/prepare-instance.mjs",
    "pretest": "node scripts/prepare-instance.mjs",
    "preweb:build": "node scripts/prepare-instance.mjs",
    "preweb:dev": "node scripts/prepare-instance.mjs",
    "precost:benchmark": "node scripts/prepare-instance.mjs",
    "wrangler": "node scripts/wrangler.mjs",
    "demo": "node scripts/demo.mjs",
    "instance:init": "cd .. && python3 -m collector.init_instance",
    "release:export": "cd .. && python3 scripts/export_public.py"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261014.1",
    "@tailwindcss/vite": "4.3.3",
    "@types/he": "^1.2.3",
    "@types/node": "^26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "esbuild": "0.28.2",
    "prettier": "^3.9.10",
    "tailwindcss": "4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "undici": "^7.29.1",
    "vite": "8.3.4",
    "wrangler": "^4.149.0"
  },
  "dependencies": {
    "@radix-ui/react-slot": "1.2.3",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "he": "^2.0.0",
    "lucide-react": "1.55.0",
    "motion": "14.2.0",
    "radix-ui": "1.8.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "tailwind-merge": "3.7.0"
  },
  "license": "MIT",
  "engines": {
    "node": ">=22.18.0"
  }
}
